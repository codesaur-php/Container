{
    "name": "codesaur/container",
    "description": "Хөнгөн, хурдан, PSR-11 стандартад нийцсэн dependency injection container",
    "keywords": [
        "container", "dependency injection", "psr-11",
        "mongol", "mongolia", "монгол", "codesaur",
        "narankhuu", "coden", "кодзавр", "наранхүү", "коден"
    ],
    "homepage": "https://github.com/codesaur-php",
    "authors": [
        {
            "name": "Narankhuu",
            "email": "codesaur@gmail.com",
            "homepage": "https://github.com/codesaur"
        }
    ],
    "require": {
        "php": "^8.2.1",
        "psr/container": "^2.0.2"
    },
    "autoload": {
        "psr-4": {
            "codesaur\\Container\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "codesaur\\Container\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text"
    },
    "license": "MIT",
    "minimum-stability": "dev"
}
